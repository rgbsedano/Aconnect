# Ollama AI Configuration
# Copy this file to .env and adjust the host/model for your local Ollama instance
# DO NOT commit .env to version control

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=gemma:4b

# Database settings
# Linux (toolbox/PHP server): host=127.0.0.1, pass=password
# Windows (XAMPP):            host=localhost, pass=
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=aconnect_db

# Base URL
# Linux (PHP dev server on port 8080): http://localhost:8080/
# Windows (XAMPP subdirectory):        http://localhost/Aconnect_ci3
BASE_URL=http://localhost/Aconnect_ci3
