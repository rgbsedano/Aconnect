generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model activity_logs {
  id         Int       @id @default(autoincrement())
  alumni_id  Int
  activity   String    @db.Text
  created_at DateTime? @default(now()) @db.DateTime(0)
  alumni     alumni    @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "activity_logs_ibfk_1")

  @@index([alumni_id], map: "alumni_id")
}

model admin_users {
  id                                    Int       @id @default(autoincrement())
  username                              String    @unique(map: "username") @db.VarChar(100)
  email                                 String    @unique(map: "email") @db.VarChar(100)
  password                              String    @db.VarChar(255)
  created_at                            DateTime  @default(now()) @db.Timestamp(0)
  last_login                            DateTime? @db.DateTime(0)
  first_name                            String?   @db.VarChar(100)
  last_name                             String?   @db.VarChar(100)
  events_events_created_byToadmin_users events[]  @relation("events_created_byToadmin_users")
  events_events_updated_byToadmin_users events[]  @relation("events_updated_byToadmin_users")
  jobs_jobs_posted_byToadmin_users      jobs[]    @relation("jobs_posted_byToadmin_users")
  jobs_jobs_updated_byToadmin_users     jobs[]    @relation("jobs_updated_byToadmin_users")
  post_post_created_byToadmin_users     post[]    @relation("post_created_byToadmin_users")
  post_post_updated_byToadmin_users     post[]    @relation("post_updated_byToadmin_users")
}

model alumni {
  id                                                          Int                   @id @default(autoincrement())
  alumni_number                                               String?               @unique(map: "alumni_number") @db.VarChar(50)
  first_name                                                  String?               @db.VarChar(100)
  last_name                                                   String?               @db.VarChar(100)
  gender                                                      alumni_gender?
  email                                                       String                @unique(map: "email") @db.VarChar(100)
  alternative_email                                           String?               @db.VarChar(100)
  password                                                    String                @db.VarChar(255)
  phone                                                       String?               @db.VarChar(20)
  alternative_phone                                           String?               @db.VarChar(20)
  telephone                                                   String?               @db.VarChar(50)
  year_admitted                                               Int
  graduation_year                                             Int?
  degree                                                      String?               @db.VarChar(100)
  profile_image                                               String?               @db.VarChar(255)
  student_number                                              String?               @unique(map: "student_number") @db.VarChar(50)
  last_login                                                  DateTime              @default(now()) @db.Timestamp(0)
  status                                                      alumni_status?        @default(inactive)
  current_job                                                 String?               @db.VarChar(100)
  current_job_organization                                    String?               @db.VarChar(150)
  current_job_length                                          String?               @db.VarChar(50)
  soft_skills                                                 String?               @db.Text
  technical_skills                                            String?               @db.Text
  school                                                      String?               @db.VarChar(100)
  created_at                                                  DateTime              @default(now()) @db.Timestamp(0)
  email_verified                                              Boolean               @default(false)
  verification_token                                          String?               @db.VarChar(128)
  verification_sent_at                                        DateTime?             @db.DateTime(0)
  activity_logs                                               activity_logs[]
  connection_requests_connection_requests_sender_idToalumni   connection_requests[] @relation("connection_requests_sender_idToalumni")
  connection_requests_connection_requests_receiver_idToalumni connection_requests[] @relation("connection_requests_receiver_idToalumni")
  connections_connections_sender_idToalumni                   connections[]         @relation("connections_sender_idToalumni")
  connections_connections_receiver_idToalumni                 connections[]         @relation("connections_receiver_idToalumni")
  employment                                                  employment[]
  messages_messages_sender_idToalumni                         messages[]            @relation("messages_sender_idToalumni")
  messages_messages_receiver_idToalumni                       messages[]            @relation("messages_receiver_idToalumni")
  tracer_responses                                            tracer_responses[]
}

model carousel_photos {
  id          Int      @id @default(autoincrement())
  file_name   String   @db.VarChar(255)
  uploaded_at DateTime @default(now()) @db.Timestamp(0)
}

model connection_requests {
  id                                             Int                         @id @default(autoincrement())
  sender_id                                      Int
  receiver_id                                    Int
  status                                         connection_requests_status? @default(pending)
  created_at                                     DateTime                    @default(now()) @db.Timestamp(0)
  alumni_connection_requests_sender_idToalumni   alumni                      @relation("connection_requests_sender_idToalumni", fields: [sender_id], references: [id], onUpdate: Restrict, map: "connection_requests_ibfk_1")
  alumni_connection_requests_receiver_idToalumni alumni                      @relation("connection_requests_receiver_idToalumni", fields: [receiver_id], references: [id], onUpdate: Restrict, map: "connection_requests_ibfk_2")

  @@index([receiver_id], map: "receiver_id")
  @@index([sender_id], map: "sender_id")
}

model connections {
  id                                     Int                 @id @default(autoincrement())
  sender_id                              Int
  receiver_id                            Int
  status                                 connections_status? @default(pending)
  created_at                             DateTime            @default(now()) @db.Timestamp(0)
  alumni_connections_sender_idToalumni   alumni              @relation("connections_sender_idToalumni", fields: [sender_id], references: [id], onUpdate: Restrict, map: "connections_ibfk_1")
  alumni_connections_receiver_idToalumni alumni              @relation("connections_receiver_idToalumni", fields: [receiver_id], references: [id], onUpdate: Restrict, map: "connections_ibfk_2")

  @@index([receiver_id], map: "receiver_id")
  @@index([sender_id], map: "sender_id")
}

model email_queue {
  id         Int                 @id @default(autoincrement())
  recipient  String              @db.Text
  subject    String              @db.VarChar(255)
  body       String              @db.MediumText
  attempts   Int?                @default(0) @db.UnsignedTinyInt
  status     email_queue_status? @default(pending)
  created_at DateTime?           @default(now()) @db.DateTime(0)
  send_after DateTime?           @db.DateTime(0)
}

model employment {
  id                Int                          @id @default(autoincrement())
  alumni_id         Int
  employment_status employment_employment_status
  company_name      String?                      @db.VarChar(255)
  job_title         String?                      @db.VarChar(255)
  job_description   String                       @db.Text
  year_of_service   Int?                         @default(0)
  promotion_count   Int?                         @default(0)
  created_at        DateTime?                    @default(now()) @db.DateTime(0)
  alumni            alumni                       @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_employment_alumni")

  @@index([alumni_id], map: "fk_employment_alumni")
}

model event_registrations {
  id            Int      @id @default(autoincrement())
  event_id      Int?
  alumni_id     Int?
  registered_at DateTime @default(now()) @db.Timestamp(0)
}

model events {
  id                                         Int          @id @default(autoincrement())
  event_name                                 String?      @db.VarChar(255)
  event_date                                 DateTime?    @db.DateTime(0)
  event_time_duration                        String?      @db.VarChar(100)
  location                                   String?      @db.VarChar(255)
  contact_person                             String?      @db.VarChar(100)
  description                                String?      @db.Text
  image                                      String?      @db.VarChar(255)
  created_by                                 Int?
  updated_by                                 Int?
  created_at                                 DateTime?    @default(now()) @db.DateTime(0)
  updated_at                                 DateTime?    @db.DateTime(0)
  admin_users_events_created_byToadmin_users admin_users? @relation("events_created_byToadmin_users", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "events_ibfk_1")
  admin_users_events_updated_byToadmin_users admin_users? @relation("events_updated_byToadmin_users", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "events_ibfk_2")

  @@index([created_by], map: "created_by")
  @@index([updated_by], map: "updated_by")
}

model job_applications {
  id         Int      @id @default(autoincrement())
  job_id     Int?
  alumni_id  Int?
  applied_at DateTime @default(now()) @db.Timestamp(0)
}

model jobs {
  id                                       Int          @id @default(autoincrement())
  job_title                                String?      @db.VarChar(150)
  company                                  String?      @db.VarChar(150)
  description                              String?      @db.Text
  location                                 String?      @db.VarChar(100)
  salary_range                             String?      @db.VarChar(100)
  qualifications                           String?      @db.Text
  contact_details                          String?      @db.VarChar(255)
  image_filename                           String?      @db.VarChar(255)
  posted_by                                Int?
  target_schools                           String?      @db.Text
  updated_by                               Int?
  created_at                               DateTime?    @default(now()) @db.DateTime(0)
  updated_at                               DateTime?    @db.DateTime(0)
  target_courses                           String?      @db.Text
  admin_users_jobs_posted_byToadmin_users  admin_users? @relation("jobs_posted_byToadmin_users", fields: [posted_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "jobs_ibfk_1")
  admin_users_jobs_updated_byToadmin_users admin_users? @relation("jobs_updated_byToadmin_users", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "jobs_ibfk_2")

  @@index([posted_by], map: "posted_by")
  @@index([updated_by], map: "updated_by")
}

model messages {
  id                                  Int      @id @default(autoincrement())
  sender_id                           Int
  receiver_id                         Int
  message                             String   @db.Text
  sent_at                             DateTime @default(now()) @db.Timestamp(0)
  alumni_messages_sender_idToalumni   alumni   @relation("messages_sender_idToalumni", fields: [sender_id], references: [id], onUpdate: Restrict, map: "messages_ibfk_1")
  alumni_messages_receiver_idToalumni alumni   @relation("messages_receiver_idToalumni", fields: [receiver_id], references: [id], onUpdate: Restrict, map: "messages_ibfk_2")

  @@index([receiver_id], map: "receiver_id")
  @@index([sender_id], map: "sender_id")
}

model post {
  id                                       Int             @id @default(autoincrement())
  title                                    String?         @db.VarChar(255)
  content                                  String?         @db.Text
  post_type                                post_post_type?
  image                                    String?         @db.VarChar(255)
  recipient_batch                          String?         @db.Text
  created_by                               Int?
  updated_by                               Int?
  created_at                               DateTime        @default(now()) @db.Timestamp(0)
  updated_at                               DateTime?       @db.Timestamp(0)
  admin_users_post_created_byToadmin_users admin_users?    @relation("post_created_byToadmin_users", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "post_ibfk_1")
  admin_users_post_updated_byToadmin_users admin_users?    @relation("post_updated_byToadmin_users", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "post_ibfk_2")

  @@index([created_by], map: "created_by")
  @@index([updated_by], map: "updated_by")
}

model support_messages {
  id          Int       @id @default(autoincrement())
  sender_id   Int
  receiver_id Int
  message     String    @db.Text
  is_admin    Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.DateTime(0)
}

model tracer_responses {
  id                Int                                @id @default(autoincrement())
  alumni_id         Int
  year_graduated    Int
  employment_status tracer_responses_employment_status
  company_name      String?                            @db.VarChar(255)
  job_title         String?                            @db.VarChar(255)
  job_description   String?                            @db.Text
  year_of_service   Int?                               @default(0)
  promotion_count   Int?                               @default(0)
  created_at        DateTime?                          @default(now()) @db.DateTime(0)
  alumni            alumni                             @relation(fields: [alumni_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "tracer_responses_ibfk_1")

  @@index([alumni_id], map: "alumni_id")
}

enum employment_employment_status {
  Employed
  Unemployed
  Self_employed @map("Self-employed")
}

enum connections_status {
  pending
  accepted
  declined
}

enum connection_requests_status {
  pending
  accepted
  declined
}

enum post_post_type {
  announcements
  news
  stories
}

enum tracer_responses_employment_status {
  Employed
  Unemployed
  Self_employed @map("Self-employed")
}

enum alumni_gender {
  male
  female
  other
}

enum email_queue_status {
  pending
  sent
  failed
}

enum alumni_status {
  active
  inactive
}
